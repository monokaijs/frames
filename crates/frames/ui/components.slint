export global Theme {
    out property <color> ink: #30343b;
    out property <color> muted: #7a7f89;
    out property <color> accent: #304bd2;
    out property <color> line: #eaecf0;
    out property <color> canvas: white;
    out property <color> green: #25825e;
    out property <color> rail: #1c2785;
}

export component Glyph inherits Rectangle {
    in property <image> source;
    in property <brush> colorize: Theme.muted;
    preferred-width: 18px; preferred-height: 18px;
    horizontal-stretch: 0;
    Image {
        source: root.source; colorize: root.colorize;
        width: min(parent.width, parent.height); height: self.width;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        image-fit: contain;
    }
}

export component AppButton inherits Rectangle {
    in property <string> label;
    in property <string> a11y-label: label;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <image> icon;
    callback clicked();
    forward-focus: focus;
    height: 32px;
    horizontal-stretch: 0;
    min-width: root.label == "" ? 32px : content.preferred-width + 10px;
    border-radius: 5px;
    background: !enabled ? #f1f2f4 : primary ? (touch.pressed ? #233aac : (touch.has-hover || focus.has-focus) ? #2943c4 : Theme.accent) : (touch.has-hover || focus.has-focus) ? (danger ? #fff2f2 : #f5f6f9) : quiet ? transparent : white;
    border-width: quiet || primary ? 0px : 1px;
    border-color: #d6d9e0;
    animate background { duration: 100ms; }
    content := HorizontalLayout {
        alignment: center; spacing: 6px;
        padding-left: root.label == "" ? 0px : 10px;
        padding-right: root.label == "" ? 0px : 10px;
        if root.icon.width > 0: Glyph { source: root.icon; colorize: !root.enabled ? #a2a7b0 : root.primary ? white : root.danger ? #b34e54 : Theme.muted; width: 15px; }
        if root.label != "": Text { text: root.label; color: !root.enabled ? #969ca7 : root.primary ? white : root.danger ? #ac444c : Theme.ink; font-size: 12px; font-weight: 500; vertical-alignment: center; }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    accessible-role: button;
    accessible-label: a11y-label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
}

export component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    in property <string> badge;
    callback clicked();
    width: 40px; height: 40px;
    border-radius: 6px;
    background: selected ? #354ad1 : (touch.has-hover || focus.has-focus) ? #2b389b : transparent;
    forward-focus: focus;
    Glyph { source: root.icon; colorize: root.selected ? white : #b8c0ec; width: 20px; height: 20px; x: 10px; y: 10px; }
    if root.badge != "": Rectangle { x: 29px; y: 7px; width: 6px; height: 6px; border-radius: 3px; background: #f1bd65; }
    if touch.has-hover || focus.has-focus: Rectangle {
        x: root.width + 12px; y: 6px; width: hint.preferred-width + 20px; height: 28px;
        background: #29304b; border-radius: 4px;
        hint := Text { text: root.label; color: white; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
    }
    focus := FocusScope { key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.clicked(); return accept; } return reject; } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    border-width: 0px;
    accessible-role: button; accessible-label: label;
    accessible-action-default => { root.clicked(); }
}

export component TabItem inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    callback clicked();
    height: 34px; min-width: text.preferred-width + 24px;
    horizontal-stretch: 0;
    background: (touch.has-hover || focus.has-focus) ? #f8f9fb : transparent;
    text := Text { text: root.label; color: root.selected ? Theme.accent : #707580; font-size: 12px; font-weight: root.selected ? 600 : 400; horizontal-alignment: center; vertical-alignment: center; }
    if root.selected: Rectangle { height: 2px; y: parent.height - 2px; width: parent.width; background: Theme.accent; }
    forward-focus: focus;
    focus := FocusScope { key-pressed(event) => { if event.text == " " || event.text == Key.Return { root.clicked(); return accept; } return reject; } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    border-width: 0px; border-radius: 3px;
    accessible-role: button; accessible-label: label;
    accessible-action-default => { root.clicked(); }
}

export component Badge inherits Rectangle {
    in property <string> label;
    in property <bool> success: false;
    in property <bool> warning: false;
    preferred-height: 22px; min-height: 22px; width: text.preferred-width;
    text := Text { text: root.label; color: root.success ? Theme.green : root.warning ? #9c702b : Theme.muted; font-size: 11px; vertical-alignment: center; }
}

export component Card inherits Rectangle {
    background: white;
    border-width: 1px; border-color: Theme.line; border-radius: 8px;
}

export component SectionTitle inherits Text {
    color: Theme.ink; font-size: 14px; font-weight: 500;
    vertical-alignment: center;
}

export component MutedText inherits Text {
    color: Theme.muted; font-size: 12px; wrap: word-wrap;
}
