import { LineEdit, ScrollView, ComboBox, SpinBox } from "std-widgets.slint";
import { Theme, Glyph, AppButton, AppSwitch, AppCheckBox, NavItem, TabItem, Badge, Card, SectionTitle, MutedText } from "components.slint";

export struct DeviceRow { name: string, address: string, detail: string, fingerprint: string, trusted: bool }
export struct SessionRow { id: int, name: string, detail: string, hosting: bool }

component PermissionRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> a11y-label: title + " settings";
    in property <int> state: -1;
    in property <bool> managed: false;
    callback action();
    height: 58px;
    HorizontalLayout {
        spacing: 14px;
        Glyph { source: root.icon; width: 18px; }
        Text { text: root.title; color: Theme.ink; font-size: 13px; vertical-alignment: center; horizontal-stretch: 1; }
        Badge { label: root.managed ? "Not required" : root.state == 1 ? "Allowed" : root.state == 0 ? "Required" : "Review"; success: root.state == 1 && !root.managed; warning: root.state == 0 && !root.managed; }
        if !root.managed: VerticalLayout { horizontal-stretch: 0; alignment: center; AppButton { label: root.state == 0 ? "Set up" : "Open settings"; a11y-label: root.a11y-label; quiet: true; clicked => { root.action(); } } }
    }
    Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
}

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    min-height: 66px;
    HorizontalLayout {
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1; alignment: center; spacing: 4px;
            Text { text: root.title; color: Theme.ink; font-size: 13px; }
            MutedText { text: root.detail; font-size: 11px; }
        }
        VerticalLayout { horizontal-stretch: 0; alignment: center; @children }
    }
    Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
}

export component Launcher inherits Window {
    in property <bool> design-preview: false;
    title: root.design-preview ? "Frames — visual preview" : "Frames";
    icon: @image-url("../../../assets/icons/Frames.png");
    preferred-width: 960px; preferred-height: 620px;
    min-width: 820px; min-height: 540px;
    background: white;
    default-font-family: root.mac ? "Helvetica Neue" : "Segoe UI";
    default-font-size: 13px;
    in-out property <int> page: 0;
    in-out property <int> connection-tab: 0;
    in-out property <int> device-tab: 0;
    in-out property <string> address;
    in-out property <bool> audio: false;
    in-out property <bool> desktop: false;
    in-out property <bool> default-audio: false;
    in-out property <bool> default-desktop: false;
    in-out property <bool> unattended: false;
    in-out property <bool> clipboard: true;
    in-out property <int> codec: 0;
    in-out property <int> max-streams: 8;
    in-out property <bool> settings-dirty: false;
    in-out property <bool> settings-saving: false;
    in-out property <string> settings-status;
    in-out property <bool> settings-error: false;
    in-out property <bool> permissions-open: false;
    in property <bool> sharing: false;
    in property <bool> background-sharing-registered: false;
    in property <bool> background-sharing-running: false;
    out property <bool> unattended-editable: !root.sharing && !root.background-sharing-running;
    in property <bool> discovering: false;
    in property <bool> mac: false;
    in property <int> screen-permission: -1;
    in property <int> control-permission: -1;
    in property <string> control-label: "Accessibility";
    in property <string> device-name: "This device";
    in property <string> local-address;
    in-out property <string> status;
    in-out property <bool> status-error: false;
    in-out property <string> notice;
    in property <bool> notice-error: false;
    in property <string> app-version;
    in property <string> update-status: "Check for a new version of Frames.";
    in property <bool> update-busy: false;
    in property <bool> update-ready: false;
    in property <bool> update-error: false;
    in property <[DeviceRow]> nearby;
    in property <[DeviceRow]> recent;
    in property <[DeviceRow]> trusted;
    in property <[SessionRow]> sessions;
    in-out property <string> search;
    in-out property <string> revoke-id;
    in-out property <string> revoke-name;
    private property <string> expanded-device;
    private property <string> settings-help;
    callback settings-edited();
    settings-edited => { root.settings-dirty = true; root.settings-status = ""; }
    callback save-settings();
    callback show-permissions();
    show-permissions => { root.settings-help = ""; root.permissions-open = true; root.refresh(); }
    pure callback filter-devices([DeviceRow], string) -> [DeviceRow];
    callback connect(string);
    callback toggle-sharing();
    callback discover();
    callback stop-session(int);
    callback refresh();
    callback permission(string);
    callback revoke(string);
    callback clear-history();
    callback login-settings();
    callback check-updates();
    callback restart-update();

    FocusScope {
        enabled: root.revoke-id == "" && !root.permissions-open && !root.settings-saving;
        HorizontalLayout {
            spacing: 0px;
            Rectangle { width: 56px; }
            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 56px; background: white;
                    HorizontalLayout {
                        padding-left: 24px; padding-right: 20px; spacing: 12px;
                        Text { text: root.page == 0 ? "Connections" : root.page == 1 ? "Devices" : "Settings"; color: Theme.ink; font-size: 16px; font-weight: 600; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Glyph { source: @image-url("icons/display.svg"); width: 16px; colorize: #9ca2ad; }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
                }
                ScrollView {
                    horizontal-stretch: 1; vertical-stretch: 1;
                    VerticalLayout {
                        padding: 24px; spacing: 20px;
                        if root.notice != "" && root.notice-error: Rectangle {
                            min-height: 44px; background: #fff5f5; border-radius: 5px;
                            HorizontalLayout {
                                padding: 8px; padding-left: 12px; spacing: 10px;
                                Text { text: root.notice; color: #a84d55; font-size: 12px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                                AppButton { icon: @image-url("icons/close.svg"); a11y-label: "Dismiss error"; quiet: true; clicked => { root.notice = ""; root.status-error = false; } }
                            }
                        }
                        if root.page == 0: VerticalLayout {
                            spacing: 20px;
                            HorizontalLayout {
                                TabItem { label: "Connect"; selected: root.connection-tab == 0; clicked => { root.connection-tab = 0; } }
                                TabItem { label: root.sessions.length > 0 ? "Sessions (" + root.sessions.length + ")" : "Sessions"; selected: root.connection-tab == 1; clicked => { root.connection-tab = 1; } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.connection-tab == 0: VerticalLayout {
                                spacing: 24px;
                                Card {
                                    height: 208px;
                                    HorizontalLayout {
                                        padding: 22px; spacing: 24px;
                                        VerticalLayout {
                                            min-width: 250px; horizontal-stretch: 1; spacing: 16px;
                                            SectionTitle { text: "Allow access"; }
                                            Rectangle {
                                                height: 70px; background: #f6f7f9; border-radius: 6px;
                                                VerticalLayout {
                                                    padding: 14px; spacing: 6px;
                                                    MutedText { text: "This device"; font-size: 11px; }
                                                    TextInput { text: root.local-address; read-only: true; single-line: true; font-size: 17px; color: Theme.ink; accessible-label: "This device's address"; }
                                                }
                                            }
                                            HorizontalLayout {
                                                AppButton { label: root.background-sharing-running ? "Manage sharing" : root.sharing ? "Stop sharing" : "Start sharing"; clicked => { if root.background-sharing-running { root.login-settings(); } else { root.toggle-sharing(); } } }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                        }
                                        Rectangle { width: 1px; background: Theme.line; }
                                        VerticalLayout {
                                            min-width: 290px; horizontal-stretch: 1.1; spacing: 16px;
                                            SectionTitle { text: "Connect to a device"; }
                                            VerticalLayout {
                                                spacing: 7px;
                                                MutedText { text: "IP address"; font-size: 11px; }
                                                LineEdit { height: 32px; text <=> root.address; placeholder-text: "192.168.1.10:47990"; accessible-label: "Remote IP address and port"; accepted => { root.connect(root.address); } }
                                            }
                                            HorizontalLayout {
                                                spacing: 16px;
                                                AppCheckBox { text: "Audio"; checked <=> root.audio; }
                                                AppCheckBox { text: "Desktop"; checked <=> root.desktop; }
                                                Rectangle { horizontal-stretch: 1; }
                                                AppButton { label: "Connect"; primary: true; enabled: root.address != ""; clicked => { root.connect(root.address); } }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 0px;
                                    HorizontalLayout {
                                        height: 36px;
                                        SectionTitle { text: "Nearby"; font-size: 13px; }
                                        Rectangle { horizontal-stretch: 1; }
                                        AppButton { label: root.discovering ? "Scanning…" : ""; icon: @image-url("icons/refresh.svg"); a11y-label: "Scan nearby devices"; quiet: true; enabled: !root.discovering; clicked => { root.discover(); } }
                                    }
                                    Rectangle { height: 1px; background: Theme.line; }
                                    if root.nearby.length == 0 && !root.discovering: Rectangle {
                                        height: 48px;
                                        MutedText { text: "No devices found"; vertical-alignment: center; }
                                    }
                                    for device in root.nearby: Rectangle {
                                        height: 52px;
                                        HorizontalLayout {
                                            spacing: 12px;
                                            Glyph { source: @image-url("icons/display.svg"); width: 18px; }
                                            VerticalLayout { horizontal-stretch: 1; spacing: 3px; alignment: center; Text { text: device.name; color: Theme.ink; font-size: 12px; overflow: elide; } MutedText { text: device.address; font-size: 11px; } }
                                            VerticalLayout { horizontal-stretch: 0; alignment: center; AppButton { label: "Connect"; quiet: true; clicked => { root.address = device.address; root.connect(device.address); } } }
                                        }
                                        Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
                                    }
                                }
                            }
                            if root.connection-tab == 1: VerticalLayout {
                                spacing: 0px;
                                if root.sessions.length == 0: Rectangle { height: 72px; MutedText { text: "No active sessions"; vertical-alignment: center; } }
                                for session in root.sessions: Rectangle {
                                    height: 56px;
                                    HorizontalLayout {
                                        spacing: 12px;
                                        Glyph { source: @image-url("icons/display.svg"); width: 18px; }
                                        VerticalLayout { horizontal-stretch: 1; spacing: 3px; alignment: center; Text { text: session.name; color: Theme.ink; font-size: 12px; overflow: elide; } MutedText { text: session.detail; font-size: 11px; } }
                                        VerticalLayout { horizontal-stretch: 0; alignment: center; AppButton { label: session.hosting ? "Stop" : "Disconnect"; quiet: true; danger: true; clicked => { root.stop-session(session.id); } } }
                                    }
                                    Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
                                }
                            }
                        }
                        if root.page == 1: VerticalLayout {
                            spacing: 16px;
                            HorizontalLayout {
                                TabItem { label: "Recent"; selected: root.device-tab == 0; clicked => { root.device-tab = 0; } }
                                TabItem { label: "Trusted"; selected: root.device-tab == 1; clicked => { root.device-tab = 1; root.refresh(); } }
                                Rectangle { horizontal-stretch: 1; }
                                LineEdit { height: 32px; width: 190px; text <=> root.search; placeholder-text: "Search devices"; accessible-label: "Search devices"; }
                                if root.device-tab == 0 && root.recent.length > 0: AppButton { label: "Clear"; a11y-label: "Clear recent connections"; quiet: true; clicked => { root.clear-history(); } }
                                if root.device-tab == 1: AppButton { icon: @image-url("icons/refresh.svg"); a11y-label: "Refresh trusted devices"; quiet: true; clicked => { root.refresh(); } }
                            }
                            VerticalLayout {
                                spacing: 0px;
                                Rectangle { height: 1px; background: Theme.line; }
                                if root.filter-devices(root.device-tab == 0 ? root.recent : root.trusted, root.search).length == 0: Rectangle {
                                    height: 64px;
                                    MutedText { text: root.search != "" ? "No matches" : root.device-tab == 0 ? "No recent connections" : "No trusted devices"; vertical-alignment: center; }
                                }
                                if root.device-tab == 0: VerticalLayout {
                                    spacing: 0px;
                                    for device in root.filter-devices(root.recent, root.search): Rectangle {
                                        height: 52px;
                                        HorizontalLayout {
                                            spacing: 12px;
                                            Glyph { source: @image-url("icons/display.svg"); width: 18px; }
                                            Text { text: device.name; color: Theme.ink; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                            MutedText { text: device.detail; font-size: 11px; vertical-alignment: center; }
                                            VerticalLayout { horizontal-stretch: 0; alignment: center; AppButton { label: "Connect"; quiet: true; clicked => { root.address = device.address; root.page = 0; root.connect(device.address); } } }
                                        }
                                        Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
                                    }
                                }
                                if root.device-tab == 1: VerticalLayout {
                                    spacing: 0px;
                                    for device in root.filter-devices(root.trusted, root.search): Rectangle {
                                        height: root.expanded-device == device.fingerprint ? 88px : 52px;
                                        VerticalLayout {
                                            spacing: 0px;
                                            HorizontalLayout {
                                                height: 52px; spacing: 12px;
                                                Glyph { source: @image-url("icons/display.svg"); width: 18px; }
                                                Text { text: device.name; color: Theme.ink; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                                Badge { label: device.detail; }
                                                VerticalLayout { horizontal-stretch: 0; alignment: center; AppButton { icon: @image-url("icons/info.svg"); a11y-label: "Details for " + device.name; quiet: true; clicked => { root.expanded-device = root.expanded-device == device.fingerprint ? "" : device.fingerprint; } } }
                                                VerticalLayout { horizontal-stretch: 0; alignment: center; AppButton { label: "Revoke"; a11y-label: "Revoke access for " + device.name; quiet: true; danger: true; clicked => { root.revoke-id = device.fingerprint; root.revoke-name = device.name; } } }
                                            }
                                            if root.expanded-device == device.fingerprint: TextInput { text: device.fingerprint; read-only: true; single-line: true; font-size: 11px; font-family: root.mac ? "Menlo" : "Consolas"; color: Theme.muted; accessible-label: "Certificate fingerprint for " + device.name; }
                                        }
                                        Rectangle { y: parent.height - 1px; height: 1px; width: parent.width; background: Theme.line; }
                                    }
                                }
                            }
                        }
                        if root.page == 2: VerticalLayout {
                            spacing: 20px;
                            VerticalLayout {
                                spacing: 10px;
                                SectionTitle { text: "Frames " + root.app-version; }
                                Text { text: root.update-status; color: root.update-error ? #a84d55 : Theme.muted; font-size: 12px; wrap: word-wrap; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    AppButton { label: root.update-busy ? "Updating…" : "Check for updates"; enabled: !root.update-busy; clicked => { root.check-updates(); } }
                                    if root.update-ready: AppButton { label: "Restart to update"; primary: true; enabled: root.sessions.length == 0 && !root.background-sharing-running; clicked => { root.restart-update(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                                if root.update-ready && root.sessions.length > 0: MutedText { text: "Stop running sessions before restarting to update."; font-size: 11px; wrap: word-wrap; }
                                if root.update-ready && root.background-sharing-running: MutedText { text: "Background sharing is running. Stop it in sharing-at-login settings before restarting to update."; font-size: 11px; wrap: word-wrap; }
                            }
                            MutedText { text: "Choose defaults for new connections and sharing sessions."; }
                            VerticalLayout {
                                spacing: 0px;
                                SectionTitle { text: "Connections"; height: 30px; }
                                SettingRow { title: "Default view"; detail: "Open individual apps or the full remote desktop.";
                                    ComboBox { width: 180px; model: ["Application windows", "Full desktop"]; current-index: root.default-desktop ? 1 : 0; selected(value) => { root.default-desktop = self.current-index == 1; root.settings-edited(); } accessible-label: "Default connection view"; }
                                }
                                SettingRow { title: "Host audio"; detail: "Play sound from the remote computer.";
                                    AppSwitch { checked <=> root.default-audio; toggled => { root.settings-edited(); } accessible-label: "Host audio by default"; }
                                }
                                SettingRow { title: "Video codec"; detail: "Automatic selects a working codec for both devices.";
                                    ComboBox { width: 180px; model: ["Automatic", "H.264", "HEVC", "AV1", "VP9"]; current-index <=> root.codec; selected(value) => { root.settings-edited(); } accessible-label: "Video codec"; }
                                }
                                SectionTitle { text: "Sharing"; height: 40px; }
                                SettingRow { title: "Clipboard sync"; detail: "Share text and images in both directions.";
                                    AppSwitch { checked <=> root.clipboard; toggled => { root.settings-edited(); } accessible-label: "Clipboard sync"; }
                                }
                                SettingRow { title: "Unattended access"; detail: root.background-sharing-running ? "Enabled by sharing at login." : root.sharing ? "Stop sharing to change this setting." : "Allow approved devices to reconnect without a prompt.";
                                    if root.background-sharing-running: AppSwitch { checked: true; enabled: false; accessible-label: "Unattended access"; }
                                    if !root.background-sharing-running: AppSwitch { checked <=> root.unattended; toggled => { root.settings-edited(); } enabled: root.unattended-editable; accessible-label: "Unattended access"; }
                                }
                                SettingRow { title: "Shared window limit"; detail: "Maximum windows streamed at the same time, per connection.";
                                    SpinBox { width: 140px; minimum: 1; maximum: 32; value <=> root.max-streams; edited => { root.settings-edited(); } accessible-label: "Shared window limit"; }
                                }
                                if root.mac: SettingRow { title: "Sharing at login"; detail: root.background-sharing-registered ? "Enabled. Sharing starts when you sign in." : "Manage background sharing on this Mac.";
                                    AppButton { label: "Manage"; a11y-label: "Manage sharing at login"; quiet: true; clicked => { root.login-settings(); } }
                                }
                            }
                        }
                        Rectangle { vertical-stretch: 1; min-height: 1px; }
                    }
                }
                if root.page == 2: Rectangle {
                    height: 64px; vertical-stretch: 0; background: white;
                    Rectangle { x: 0px; y: 0px; height: 1px; width: parent.width; background: Theme.line; }
                    HorizontalLayout {
                        padding-left: 24px; padding-right: 24px; spacing: 12px;
                        Text { text: root.settings-status != "" ? root.settings-status : root.settings-dirty ? "Unsaved changes" : "Changes apply to new sessions."; color: root.settings-error && root.settings-status != "" ? #a84d55 : Theme.muted; font-size: 12px; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                        VerticalLayout { horizontal-stretch: 0; alignment: center;
                            AppButton { label: root.settings-saving ? "Saving..." : "Save changes"; primary: true; enabled: root.settings-dirty && !root.settings-saving; clicked => { root.save-settings(); } }
                        }
                    }
                }
                Rectangle {
                    height: 32px; vertical-stretch: 0; background: white;
                    HorizontalLayout {
                        x: 0px; y: 0px; width: parent.width; height: parent.height;
                        padding-left: 24px; padding-right: 20px; spacing: 7px;
                        Rectangle { width: 6px; Rectangle { x: 0px; y: (parent.height - 6px) / 2; width: 6px; height: 6px; border-radius: 3px; background: root.notice-error && root.notice != "" ? #d79259 : root.sharing || root.background-sharing-running ? #38a66c : #a1aaa3; } }
                        Text { text: root.notice-error && root.notice != "" ? "Action needed" : root.background-sharing-running ? "Sharing at login" : root.sharing ? "Sharing" : "Ready"; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.device-name; color: #969ba5; font-size: 11px; vertical-alignment: center; overflow: elide; }
                    }
                }
            }
        }
        // Draw the rail last so hover labels can extend above the white content.
        Rectangle {
            x: 0px; y: 0px; width: 56px; height: parent.height; background: Theme.rail;
            VerticalLayout {
                padding-left: 8px; padding-right: 8px; padding-top: 12px; padding-bottom: 12px; spacing: 8px;
                Rectangle {
                    width: 40px; height: 40px;
                    Image { x: 2px; y: 2px; width: 36px; height: 36px; source: @image-url("../../../assets/icons/Frames.png"); image-fit: contain; }
                }
                Rectangle { height: 1px; background: #ffffff30; }
                Rectangle { height: 4px; }
                NavItem { label: "Connections"; icon: @image-url("icons/connections.svg"); selected: root.page == 0; clicked => { root.page = 0; } }
                NavItem { label: "Devices"; icon: @image-url("icons/devices.svg"); selected: root.page == 1; clicked => { root.page = 1; } }
                Rectangle { vertical-stretch: 1; }
                NavItem { label: "Permissions"; icon: @image-url("icons/shield.svg"); selected: root.permissions-open; badge: root.mac && (root.screen-permission == 0 || root.control-permission == 0) ? "!" : ""; clicked => { root.show-permissions(); } }
                NavItem { label: "Settings"; icon: @image-url("icons/settings.svg"); selected: root.page == 2; clicked => { root.page = 2; } }
            }
        }
    }
    if root.permissions-open: FocusScope {
        init => { self.focus(); }
        key-pressed(event) => { if event.text == Key.Escape { root.permissions-open = false; return accept; } return reject; }
        Rectangle { background: #00000066; }
        TouchArea { }
        Card {
            width: min(580px, parent.width - 48px); height: min(420px, parent.height - 48px);
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            VerticalLayout {
                padding: 24px; spacing: 12px;
                HorizontalLayout {
                    SectionTitle { text: "Permissions"; font-size: 18px; horizontal-stretch: 1; }
                    AppButton { icon: @image-url("icons/close.svg"); a11y-label: "Close permissions"; quiet: true; clicked => { root.permissions-open = false; } }
                }
                MutedText { text: root.mac ? "Allow access on this Mac to share its screen and control applications." : "Frames can capture and control apps in your signed-in session. Review the firewall to allow connections."; }
                VerticalLayout {
                    spacing: 0px;
                    PermissionRow { icon: @image-url("icons/display.svg"); title: "Screen Recording"; state: root.screen-permission; managed: !root.mac; action => { root.settings-help = root.mac ? "Privacy & Security > Screen & System Audio Recording" : ""; root.permission("screen"); } }
                    PermissionRow { icon: @image-url("icons/cursor.svg"); title: !root.mac ? "Input control" : root.control-label == "Accessibility" ? "Accessibility" : "Device control"; a11y-label: (root.mac ? root.control-label : "Input control") + " settings"; state: root.control-permission; managed: !root.mac; action => { root.settings-help = root.mac ? "Privacy & Security > " + root.control-label : ""; root.permission("control"); } }
                    PermissionRow { icon: @image-url("icons/network.svg"); title: root.mac ? "Local network" : "Firewall"; action => { root.settings-help = root.mac ? "Privacy & Security > Local Network" : "Allow Frames through the firewall on your network."; root.permission("network"); } }
                }
                if root.settings-help != "": MutedText { text: root.settings-help; font-size: 11px; }
                if root.notice != "" && root.notice-error: MutedText { text: root.notice; color: #a84d55; font-size: 11px; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    AppButton { label: "Refresh status"; icon: @image-url("icons/refresh.svg"); quiet: true; clicked => { root.refresh(); } }
                    Rectangle { horizontal-stretch: 1; }
                    AppButton { label: "Done"; primary: true; clicked => { root.permissions-open = false; } }
                }
            }
        }
    }
    if root.revoke-id != "": FocusScope {
        init => { self.focus(); }
        key-pressed(event) => { if event.text == Key.Escape { root.revoke-id = ""; return accept; } return reject; }
        Rectangle { background: #00000066; }
        TouchArea { }
        Card {
            width: 400px; height: 210px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            VerticalLayout {
                padding: 22px; spacing: 12px;
                SectionTitle { text: "Revoke access?"; font-size: 17px; }
                Text { text: root.revoke-name; color: Theme.ink; font-size: 12px; overflow: elide; }
                MutedText { text: "Pair again to reconnect. Active sessions stay connected."; font-size: 12px; }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end; spacing: 8px;
                    AppButton { label: "Cancel"; clicked => { root.revoke-id = ""; } }
                    AppButton { label: "Revoke"; danger: true; clicked => { root.revoke(root.revoke-id); root.revoke-id = ""; } }
                }
            }
        }
    }
}
