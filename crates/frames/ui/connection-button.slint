import { Theme, Glyph, AppCheckBox } from "components.slint";

component ConnectionModeOption inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();
    height: 32px; border-radius: 4px;
    background: touch.has-hover || focus.has-focus ? #f5f6f9 : transparent;
    forward-focus: focus;
    if root.selected: Glyph { x: 8px; y: 9px; width: 15px; height: 15px; source: @image-url("icons/check.svg"); colorize: Theme.ink; }
    Glyph { x: 30px; y: 9px; width: 15px; height: 15px; source: root.icon; colorize: Theme.muted; }
    Text { x: 52px; width: parent.width - 60px; height: parent.height; text: root.label; color: Theme.ink; font-size: 12px; vertical-alignment: center; }
    focus := FocusScope {
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    accessible-role: button; accessible-label: root.label;
    accessible-checkable: true; accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }
}

// One shared surface: the label connects, the chevron opens connection choices.
export component ConnectionButton inherits Rectangle {
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> align-options-right: false;
    in-out property <bool> audio: false;
    in-out property <bool> desktop: false;
    callback connect();
    callback options-edited();
    callback quick-apps();
    width: 112px; height: 32px;
    horizontal-stretch: 0;
    border-radius: 5px;
    border-width: root.primary ? 0px : 1px;
    border-color: #d6d9e0;
    background: !root.enabled ? #f1f2f4 : root.primary ? (action.pressed || dropdown.pressed ? Theme.accent-pressed : action.has-hover || dropdown.has-hover || connect-focus.has-focus || options-focus.has-focus ? Theme.accent-hover : Theme.accent) : action.has-hover || dropdown.has-hover || connect-focus.has-focus || options-focus.has-focus ? #f5f6f9 : white;
    forward-focus: connect-focus;
    // Two segments: the label acts, the chevron opens choices. The divider
    // makes them read as segments; without it the label looked off-centre.
    HorizontalLayout {
        x: 0; width: parent.width - 28px; height: parent.height;
        alignment: center; spacing: 6px;
        Glyph { width: 14px; source: @image-url("icons/arrow.svg"); colorize: !root.enabled ? #969ca7 : root.primary ? white : Theme.ink; }
        Text { text: "Connect"; font-size: 12px; font-weight: 500; color: !root.enabled ? #969ca7 : root.primary ? white : Theme.ink; vertical-alignment: center; }
    }
    Rectangle {
        x: parent.width - 28px; y: 7px; width: 1px; height: parent.height - 14px;
        background: !root.enabled ? #dfe1e5 : root.primary ? #ffffff40 : #d6d9e0;
    }
    Glyph {
        x: parent.width - 20px; y: (parent.height - 12px) / 2; width: 12px; height: 12px;
        source: @image-url("icons/chevron-down.svg");
        colorize: !root.enabled ? #969ca7 : root.primary ? white : Theme.muted;
    }
    connect-focus := FocusScope {
        x: 0px; width: parent.width - 28px; height: parent.height;
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.DownArrow { root.show-options(); return accept; }
            if event.text == " " || event.text == Key.Return { root.connect(); return accept; }
            return reject;
        }
    }
    action := TouchArea {
        x: 0; width: parent.width - 28px; enabled: root.enabled; mouse-cursor: pointer;
        clicked => { connect-focus.focus(); root.connect(); }
        accessible-role: button; accessible-label: "Connect"; accessible-enabled: root.enabled;
        accessible-action-default => { if root.enabled { root.connect(); } }
    }
    options-focus := FocusScope {
        x: parent.width - 28px; width: 28px; height: parent.height;
        focus-on-click: false;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return || event.text == Key.DownArrow { root.show-options(); return accept; }
            return reject;
        }
    }
    dropdown := TouchArea {
        x: parent.width - 28px; width: 28px; enabled: root.enabled; mouse-cursor: pointer;
        clicked => { options-focus.focus(); root.show-options(); }
        accessible-role: button; accessible-label: "Connection options"; accessible-enabled: root.enabled;
        accessible-action-default => { if root.enabled { root.show-options(); } }
    }
    function show-options() { options.show(); }
    options := PopupWindow {
        x: root.align-options-right ? root.width - self.width : 0px; y: root.height + 6px;
        width: 232px; height: 234px;
        close-policy: close-on-click-outside;
        forward-focus: menu-focus;
        menu-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape { options.close(); options-focus.focus(); return accept; }
                return reject;
            }
            Rectangle {
                background: white; border-radius: 8px; border-width: 1px; border-color: #d6d9e0;
                VerticalLayout {
                    padding: 12px; spacing: 5px;
                    Text { text: "Connection mode"; color: Theme.muted; font-size: 11px; height: 20px; }
                    ConnectionModeOption {
                        label: "Application windows"; icon: @image-url("icons/devices.svg"); selected: !root.desktop;
                        clicked => { root.desktop = false; root.options-edited(); }
                    }
                    ConnectionModeOption {
                        label: "Full desktop"; icon: @image-url("icons/display.svg"); selected: root.desktop;
                        clicked => { root.desktop = true; root.options-edited(); }
                    }
                    Rectangle { height: 1px; background: Theme.line; }
                    Rectangle {
                        height: 34px;
                        AppCheckBox { y: 7px; text: "Play host audio"; checked <=> root.audio; toggled => { root.options-edited(); } }
                    }
                    Text { text: "Remembered for your next connection"; color: Theme.muted; font-size: 10px; height: 15px; }
                    Rectangle { height: 1px; background: Theme.line; }
                    ConnectionModeOption { label: "Quick Apps…"; icon: @image-url("icons/folder.svg"); clicked => { options.close(); root.quick-apps(); } }
                }
            }
        }
    }
}

// Same split surface as ConnectionButton: the label starts or stops sharing,
// the chevron chooses what is shared. The scope is fixed while sharing.
export component SharingButton inherits Rectangle {
    in property <string> label: "Start sharing";
    in property <bool> danger: false;
    in property <bool> options-enabled: true;
    in-out property <int> mode: 0;
    callback activate();
    width: 138px; height: 32px;
    horizontal-stretch: 0;
    border-radius: 5px;
    border-width: root.danger ? 1px : 0px;
    border-color: #ac444c;
    private property <bool> hot: action.has-hover || dropdown.has-hover || action-focus.has-focus || options-focus.has-focus;
    background: root.danger ? (root.hot ? #fff2f2 : white) : action.pressed || dropdown.pressed ? Theme.accent-pressed : root.hot ? Theme.accent-hover : Theme.accent;
    forward-focus: action-focus;
    HorizontalLayout {
        x: 0; width: parent.width - 28px; height: parent.height;
        alignment: center; spacing: 6px;
        Glyph { width: 14px; source: root.danger ? @image-url("icons/power.svg") : @image-url("icons/display.svg"); colorize: root.danger ? #b34e54 : white; }
        Text { text: root.label; font-size: 12px; font-weight: 500; color: root.danger ? #b34e54 : white; vertical-alignment: center; }
    }
    Rectangle {
        x: parent.width - 28px; y: 7px; width: 1px; height: parent.height - 14px;
        background: root.danger ? #e2b8bb : #ffffff40;
    }
    Glyph {
        x: parent.width - 20px; y: (parent.height - 12px) / 2; width: 12px; height: 12px;
        source: @image-url("icons/chevron-down.svg");
        colorize: !root.options-enabled ? (root.danger ? #e2b8bb : #7c7c7c) : root.danger ? #b34e54 : white;
    }
    action-focus := FocusScope {
        x: 0px; width: parent.width - 28px; height: parent.height;
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.DownArrow && root.options-enabled { options.show(); return accept; }
            if event.text == " " || event.text == Key.Return { root.activate(); return accept; }
            return reject;
        }
    }
    action := TouchArea {
        x: 0; width: parent.width - 28px; mouse-cursor: pointer;
        clicked => { action-focus.focus(); root.activate(); }
        accessible-role: button; accessible-label: root.label;
        accessible-action-default => { root.activate(); }
    }
    options-focus := FocusScope {
        x: parent.width - 28px; width: 28px; height: parent.height;
        focus-on-click: false;
        enabled: root.options-enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return || event.text == Key.DownArrow { options.show(); return accept; }
            return reject;
        }
    }
    dropdown := TouchArea {
        x: parent.width - 28px; width: 28px; enabled: root.options-enabled; mouse-cursor: root.options-enabled ? pointer : default;
        clicked => { options-focus.focus(); options.show(); }
        accessible-role: button; accessible-label: "What to share"; accessible-enabled: root.options-enabled;
        accessible-action-default => { if root.options-enabled { options.show(); } }
    }
    options := PopupWindow {
        x: 0px; y: root.height + 6px;
        width: 232px; height: 166px;
        close-policy: close-on-click-outside;
        forward-focus: menu-focus;
        menu-focus := FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape { options.close(); options-focus.focus(); return accept; }
                return reject;
            }
            Rectangle {
                background: white; border-radius: 8px; border-width: 1px; border-color: #d6d9e0;
                VerticalLayout {
                    padding: 12px; spacing: 5px;
                    Text { text: "What to share"; color: Theme.muted; font-size: 11px; height: 20px; }
                    ConnectionModeOption { label: "Everything"; icon: @image-url("icons/display.svg"); selected: root.mode == 0; clicked => { root.mode = 0; options.close(); } }
                    ConnectionModeOption { label: "Selected windows"; icon: @image-url("icons/devices.svg"); selected: root.mode == 1; clicked => { root.mode = 1; options.close(); } }
                    ConnectionModeOption { label: "One window"; icon: @image-url("icons/display.svg"); selected: root.mode == 2; clicked => { root.mode = 2; options.close(); } }
                    Text { text: "Window choices open when you start"; color: Theme.muted; font-size: 10px; height: 15px; }
                }
            }
        }
    }
}
